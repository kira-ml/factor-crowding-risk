# ============================================================
# factor-crowding-risk
# Crowded Exits: exit risk and capacity in equity factors
# ============================================================

# ------------------------------------
# Python
# ------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ------------------------------------
# Virtual environments
# ------------------------------------
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/

# ------------------------------------
# Data and generated results
# Raw downloads, cached panels, and run outputs are reproducible
# from the manifest and are never committed.
# ------------------------------------
data/
outputs/
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
yfinance_cache/

# Generated CSVs are outputs, not sources. Result tables that
# belong in the report are generated as Markdown.
*.csv
!docs/**/*.csv

# ------------------------------------
# Documentation
# docs/ is tracked by default: Markdown, figures, and the report
# are deliverables, not build artifacts.
# ------------------------------------

